{
  "name": "leetally-extension",
  "description": "LeetCode tracker and helper to visualize progress, build consistency, follow friends, and practice AI interviews.",
  "private": true,
  "version": "0.1.18",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "test": "node --test tests/*.test.mjs",
    "compile": "tsc --noEmit",
    "format": "prettier --ignore-path ../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../.prettierignore --check .",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@ricky0123/vad-web": "^0.0.30",
    "@supabase/supabase-js": "^2.110.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "wxt": "^0.20.27"
  }
}
